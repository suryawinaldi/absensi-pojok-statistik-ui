# Optional build-time override for a staging Supabase project.
# If omitted, build uses existing public config in js/supabase.js.
# Export these variables in the shell or set them in Vercel environment settings.
# Build and development commands also load .env.local when present.
# PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# PUBLIC_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
# Never use a service_role or secret key here.

# Server-only username mapping (required for the login API).
# Use the same email as the registered Supabase Auth admin.
# Set in Vercel Production and redeploy, or .env.local for npm run dev.
# ADMIN_USERNAME=adminpojokui
# ADMIN_EMAIL=your-existing-admin-email
# Do not put the admin password in environment variables.
